{
  "name": "vinfast-vf9-studio",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "vite --port 3017",
    "build": "vite build",
    "preview": "vite preview",
    "check": "tsc --noEmit",
    "lint": "oxlint",
    "format": "oxfmt",
    "model:download": "node scripts/download-source.mjs",
    "model:sample": "node scripts/make-sample-model.mjs",
    "model:prepare": "node --experimental-strip-types scripts/prepare-model.mjs",
    "validate": "node --experimental-strip-types scripts/validate-model.mjs && node --experimental-strip-types scripts/validate-explosion.mjs && node --experimental-strip-types scripts/validate-touch.mjs"
  },
  "dependencies": {
    "@base-ui/react": "1.7.0",
    "@types/three": "^0.159.0",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "lucide-react": "1.31.0",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "shadcn": "4.18.0",
    "tailwind-merge": "3.6.0",
    "three": "^0.159.0",
    "tw-animate-css": "1.4.0"
  },
  "devDependencies": {
    "@gltf-transform/core": "4.5.0",
    "@gltf-transform/extensions": "4.5.0",
    "@gltf-transform/functions": "4.5.0",
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "meshoptimizer": "1.2.0",
    "oxfmt": "0.61.0",
    "oxlint": "1.76.0",
    "tailwindcss": "4.2.1",
    "typescript": "5.9.3",
    "vite": "8.0.13"
  }
}
